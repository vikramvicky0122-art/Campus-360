# ─── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API Server ────────────────────────────────────────────────────────────────
PORT=5000

# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma
# Example: postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/campus360_db?schema=public

# ─── Auth ──────────────────────────────────────────────────────────────────────
# JWT signing secret for auth tokens (use a long random string in production)
JWT_SECRET=replace_with_a_strong_random_secret

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated frontend origin(s) allowed by CORS
# Dev:  http://localhost:5173
# Prod: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173

# ─── Media Uploads ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Campus 360 — Payment Settings ────────────────────────────────────────────
#
# IMPORTANT: YouPI-PG is experimental and NOT production-ready.
# Real-money payments are disabled by default.
# See: https://github.com/youpi-pg/YouPI-PG — read all warnings before enabling.
#
# Payment mode:
#   mock  — simulates payment without any external gateway (local dev, CI)
#   youpi — uses YouPI-PG gateway (requires YOUPI_PG_ENABLED=true + all YOUPI_ vars below)
PAYMENT_MODE=mock

# Set to true ONLY after independent security, legal, banking, and operational review.
YOUPI_PG_ENABLED=false

# YouPI-PG payment-api base URL (e.g. http://localhost:6100 for local, or your deployed instance)
YOUPI_API_URL=http://localhost:6100

# Your YouPI-PG merchant ID (from the YouPI control center / config)
YOUPI_MERCHANT_ID=

# Your YouPI-PG merchant API key / webhook secret (keep this secret, never commit)
YOUPI_API_KEY=
YOUPI_WEBHOOK_SECRET=replace_with_your_youpi_webhook_secret

# URL to redirect borrower after payment completes
# Should point to the bookings page in the Campus 360 frontend
YOUPI_RETURN_URL=http://localhost:5173/bookings

# ─── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=
