# ─── API ──────────────────────────────────────────────────────────────────────
# Point to your Express backend.
# Local development:  http://localhost:4000
# Production:         https://your-backend.onrender.com
VITE_API_URL=http://localhost:4000

# ─── WebSocket (Socket.IO) ────────────────────────────────────────────────────
# Socket.IO runs on the same Express server, so this defaults to VITE_API_URL's origin.
# Only set this if you need to point the WebSocket connection to a different host.
# VITE_SOCKET_URL=
